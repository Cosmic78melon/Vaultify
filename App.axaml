<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:collections="using:System.Collections"
             xmlns:converters="using:Avalonia.Markup.Xaml.Converters"
             x:Class="Password_Manager.App"
             xmlns:local="using:Password_Manager"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
            <StyleInclude Source="Styles/DefaulteStyel.axaml"></StyleInclude>
    </Application.Styles>

  <Application.Resources>
	  <SolidColorBrush x:Key="Primary_Background_Color">#181612</SolidColorBrush>
	  <SolidColorBrush x:Key="Primary_SideMenu_Color">#181c1f</SolidColorBrush>
	  <SolidColorBrush x:Key="Primary_Seperator_Color">Wheat</SolidColorBrush>
	  <SolidColorBrush x:Key="Primary_Button_Background">Transparent</SolidColorBrush>
	  <SolidColorBrush x:Key="Primary_Button_Foreground">White</SolidColorBrush>
	  <SolidColorBrush x:Key="Hover_Button_Background">#FF8C00</SolidColorBrush>
      <SolidColorBrush x:Key="Card_Color">#262a2b</SolidColorBrush>

      <FontFamily x:Key="Fonts">Cooper Black,Forte,Calibri,Bahnschrift SemiBold, ArialBlack</FontFamily>
  </Application.Resources>
</Application>