                                    <TextBlock Text="danielle@email.com" FontSize="13" Foreground="#999999" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" HorizontalAlignment="Left" Margin="0,17,0,17" Background="#2A2A2A" CornerRadius="20" Padding="18,6">
                                    <TextBlock Text="Shopping" FontSize="14" Foreground="#CCCCCC" FontWeight="Medium"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="a few hours ago" VerticalAlignment="Center" FontSize="15" Foreground="#999999" HorizontalAlignment="Right" Margin="0,0,32,0"/>
                                <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="12" HorizontalAlignment="Right" Margin="0,0,16,0">
                                    <icons:SymbolIcon Symbol="MoreHorizontal" Foreground="#777777" FontSize="22"/>
                                </Button>
                            </Grid>
                            <Separator Background="#252525" Height="1" Margin="16,0"/>
                           
                            <!-- Entry 5: American Airlines -->
                            <Grid ColumnDefinitions="72,*,220,160,140,80" Height="68" Background="Transparent">
                                <Border Grid.Column="0" Width="42" Height="42" Background="#2196F3" CornerRadius="10" Margin="16,13,0,13">
                                    <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="20"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,13,0,13" VerticalAlignment="Center">
                                    <TextBlock Text="americanairlines.com" FontSize="17" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="danielle@email.com" FontSize="13" Foreground="#999999" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" HorizontalAlignment="Left" Margin="0,17,0,17" Background="#2A2A2A" CornerRadius="20" Padding="18,6">
                                    <TextBlock Text="Travel" FontSize="14" Foreground="#CCCCCC" FontWeight="Medium"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="4 months ago" VerticalAlignment="Center" FontSize="15" Foreground="#999999" HorizontalAlignment="Right" Margin="0,0,32,0"/>
                                <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="12" HorizontalAlignment="Right" Margin="0,0,16,0">
                                    <icons:SymbolIcon Symbol="MoreHorizontal" Foreground="#777777" FontSize="22"/>
                                </Button>
                            </Grid>
                            <Separator Background="#252525" Height="1" Margin="16,0"/>
                           
                            <!-- Entry 6: American Express -->
                            <Grid ColumnDefinitions="72,*,220,160,140,80" Height="68" Background="Transparent">
                                <Border Grid.Column="0" Width="42" Height="42" Background="#1976D2" CornerRadius="10" Margin="16,13,0,13">
                                    <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="20"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,13,0,13" VerticalAlignment="Center">
                                    <TextBlock Text="americanexpress.com" FontSize="17" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="danielle@email.com" FontSize="13" Foreground="#999999" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" HorizontalAlignment="Left" Margin="0,17,0,17" Background="#2A2A2A" CornerRadius="20" Padding="18,6">
                                    <TextBlock Text="Banking" FontSize="14" Foreground="#CCCCCC" FontWeight="Medium"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="5 days ago" VerticalAlignment="Center" FontSize="15" Foreground="#999999" HorizontalAlignment="Right" Margin="0,0,32,0"/>
                                <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="12" HorizontalAlignment="Right" Margin="0,0,16,0">
                                    <icons:SymbolIcon Symbol="MoreHorizontal" Foreground="#777777" FontSize="22"/>
                                </Button>
                            </Grid>
                            <Separator Background="#252525" Height="1" Margin="16,0"/>
                           
                            <!-- Entry 7: AppAnnie -->
                            <Grid ColumnDefinitions="72,*,220,160,140,80" Height="68" Background="Transparent">
                                <Border Grid.Column="0" Width="42" Height="42" Background="#9E9E9E" CornerRadius="10" Margin="16,13,0,13">
                                    <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="20"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,13,0,13" VerticalAlignment="Center">
                                    <TextBlock Text="appannie.com" FontSize="17" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="danielle@email.com" FontSize="13" Foreground="#999999" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" HorizontalAlignment="Left" Margin="0,17,0,17" Background="#2A2A2A" CornerRadius="20" Padding="18,6">
                                    <TextBlock Text="Business" FontSize="14" Foreground="#CCCCCC" FontWeight="Medium"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="last year" VerticalAlignment="Center" FontSize="15" Foreground="#999999" HorizontalAlignment="Right" Margin="0,0,32,0"/>
                                <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="12" HorizontalAlignment="Right" Margin="0,0,16,0">
                                    <icons:SymbolIcon Symbol="MoreHorizontal" Foreground="#777777" FontSize="22"/>
                                </Button>
                            </Grid>
                            <Separator Background="#252525" Height="1" Margin="16,0"/>
                           
                            <!-- Entry 8: Apple -->
                            <Grid ColumnDefinitions="72,*,220,160,140,80" Height="68" Background="Transparent">
                                <Border Grid.Column="0" Width="42" Height="42" Background="#424242" CornerRadius="10" Margin="16,13,0,13">
                                    <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="20"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,13,0,13" VerticalAlignment="Center">
                                    <TextBlock Text="apple.com" FontSize="17" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="danielle@email.com" FontSize="13" Foreground="#999999" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" HorizontalAlignment="Left" Margin="0,17,0,17" Background="#2A2A2A" CornerRadius="20" Padding="18,6">
                                    <TextBlock Text="Tech" FontSize="14" Foreground="#CCCCCC" FontWeight="Medium"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="a few hours ago" VerticalAlignment="Center" FontSize="15" Foreground="#999999" HorizontalAlignment="Right" Margin="0,0,32,0"/>
                                <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="12" HorizontalAlignment="Right" Margin="0,0,16,0">
                                    <icons:SymbolIcon Symbol="MoreHorizontal" Foreground="#777777" FontSize="22"/>
                                </Button>
                            </Grid>
                            <Separator Background="#252525" Height="1" Margin="16,0"/>
                           
                            <!-- Entry 9: Asana -->
                            <Grid ColumnDefinitions="72,*,220,160,140,80" Height="68" Background="Transparent">
                                <Border Grid.Column="0" Width="42" Height="42" Background="#FF5722" CornerRadius="10" Margin="16,13,0,13">
                                    <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="20"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,13,0,13" VerticalAlignment="Center">
                                    <TextBlock Text="asana.com" FontSize="17" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="danielle@email.com" FontSize="13" Foreground="#999999" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" HorizontalAlignment="Left" Margin="0,17,0,17" Background="#2A2A2A" CornerRadius="20" Padding="18,6">
                                    <TextBlock Text="Business" FontSize="14" Foreground="#CCCCCC" FontWeight="Medium"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="2 weeks ago" VerticalAlignment="Center" FontSize="15" Foreground="#999999" HorizontalAlignment="Right" Margin="0,0,32,0"/>
                                <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="12" HorizontalAlignment="Right" Margin="0,0,16,0">
                                    <icons:SymbolIcon Symbol="MoreHorizontal" Foreground="#777777" FontSize="22"/>
                                </Button>
                            </Grid>
                            <Separator Background="#252525" Height="1" Margin="16,0"/>
                           
                            <!-- Entry 10: Asos -->
                            <Grid ColumnDefinitions="72,*,220,160,140,80" Height="68" Background="Transparent">
                                <Border Grid.Column="0" Width="42" Height="42" Background="#212121" CornerRadius="10" Margin="16,13,0,13">
                                    <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="20"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,13,0,13" VerticalAlignment="Center">
