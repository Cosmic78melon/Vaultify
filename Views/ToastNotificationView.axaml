<UserControl
    Background="Transparent"
    mc:Ignorable="d"
    x:Class="Vaultify.Views.ToastNotificationView"
    x:DataType="vm:ToastNotificationViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Vaultify.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Background="{Binding ColorBG}"
        BorderBrush="#3C3C3C"
        BorderThickness="1"
        CornerRadius="10"
        Height="80"
        HorizontalAlignment="Right"
        IsVisible="{Binding IsVisible}"
        Margin="10"
        Opacity="65"
        Width="380">

        <Grid ColumnDefinitions="6,Auto,*,Auto">

            <!--  Left Accent  -->
            <Border CornerRadius="10,0,0,10" Grid.Column="0" />

            <!--  Icon  -->
            <Border
                Background="{Binding ColorSFG}"
                CornerRadius="17"
                Grid.Column="1"
                Height="34"
                Margin="12"
                VerticalAlignment="Center"
                Width="34">
                <icons:SymbolIcon
                    FontSize="18"
                    Foreground="LightGray"
                    HorizontalAlignment="Center"
                    Symbol="{Binding IconName}"
                    VerticalAlignment="Center" />
            </Border>

            <!--  Text  -->
            <StackPanel
                Grid.Column="2"
                Spacing="2"
                VerticalAlignment="Center">

                <TextBlock
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding Title}" />

                <TextBlock
                    FontSize="13"
                    Foreground="#D0D0D0"
                    Text="{Binding Message}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
