<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:Password_Manager.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1700" d:DesignHeight="800"
             xmlns:icons="using:FluentIcons.Avalonia"
             x:DataType="viewmodels:All_EntriesPageViewModel"
             Background="#0A0A0A"
             x:Class="Password_Manager.All_EntriesPageView">

    <!-- Main Layout: Sidebar + Content (Black & Orange Theme) -->
    <Grid ColumnDefinitions="*" RowDefinitions="Auto,*">
       
        <!-- ===================== -->
        <!-- MAIN CONTENT (Black & Orange) -->
        <!-- ===================== -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,0,0">
           
            <!-- Top Bar -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="32,28,32,12">
               
                <!-- Page Title -->
                <TextBlock Text="Your Passwords"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
               
                <!-- Action Buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                   
                    <!-- Add New -->
                    <Button Classes="Vault" Command="{Binding AddnewPOPButtonCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SymbolIcon Symbol="Add" FontSize="20"/>
                            <TextBlock Text="Add new"/>
                        </StackPanel>
                    </Button>
                   
                    <!-- Share -->
                    <Button Classes="Vault" Command="{Binding SharePOPButtonCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SymbolIcon Symbol="Share" FontSize="20"/>
                            <TextBlock Text="Share"/>
                        </StackPanel>
                    </Button>
                   
                    <!-- Change passwords -->
                    <Button Classes="Vault" Command="{Binding ChangePasswordPOPButtonCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SymbolIcon Symbol="ArrowSync" FontSize="20"/>
                            <TextBlock Text="Change passwords"/>
                            <Border Background="#FF8C00"
                                    CornerRadius="6"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="BETA"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Button>
                   
                </StackPanel>
               
            </Grid>
           
            <!-- Passwords Table -->
            <Border Grid.Row="1"
                    Margin="32,0,32,32"
                    Background="#1A1A1A"
                    CornerRadius="16"
                    ClipToBounds="True">
               
                <Grid>
                   
                   <!-- Table Header -->
<Grid Grid.Row="0"
      ColumnDefinitions="*,*,*,*"
      Height="56"
      Background="#222222"
      VerticalAlignment="Top">

    <!-- Name -->
    <TextBlock Grid.Column="0"
               Text="NAME"
               FontSize="14"
               FontWeight="SemiBold"
               Foreground="#777777"
               VerticalAlignment="Center"
               Margin="12,0,0,0"/>

    <!-- Email -->
    <TextBlock Grid.Column="2"
               Text="Email"
               FontSize="14"
               Foreground="#777777"
               VerticalAlignment="Center"/>

    <!-- Category -->
    <TextBlock Grid.Column="3"
               Text="CATEGORY"
               FontSize="14"
               FontWeight="SemiBold"
               Foreground="#777777"
               VerticalAlignment="Center"/>

</Grid>
                   
                    <!-- Scrollable Entries -->
                    <ListBox Grid.Row="1" Margin="0, 56, 0, 0" Background="#1A1A1A" ItemsSource="{Binding Items}">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="470">
                                <TextBlock Text="{Binding Title}" Height="35" Foreground="White"/>
                                <TextBlock Text="{Binding Password}" Height="35" Foreground="White"/>
                              </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>						
                    </ListBox>
                </Grid>
            </Border>
           
        </Grid>

        <!-- Dimming Overlay for Add New -->
        <!-- this is The New ADD Pop up window code -->
        <Border Grid.RowSpan="2" 
                IsVisible="{Binding AddnewOP}"
                Background="#80000000"  
                ZIndex="1000"/>

        <!-- Interactive Popup for Add New (small "window" centered) -->
        <!-- this is The New ADD Pop up window code -->
        <Border Grid.RowSpan="2"
                ZIndex="1001"
                IsVisible="{Binding AddnewPOP}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1A1A1A" 
                CornerRadius="16" 
                Padding="20" 
                Width="500" Height="300">
            <StackPanel Spacing="10">
                <TextBlock Text="Add New Entry" FontSize="20" Foreground="White" FontWeight="Bold"/>
                <TextBlock Text="Instructions: Enter details below." Foreground="#CCCCCC"/>
                <TextBox Watermark="Name (e.g., example.com)" />
                <TextBox Watermark="Passsword" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button  Classes="Vault" Content="New Password"/>
                    <Button  Classes="Vault" Content="Save"/>
                    <Button  Classes="Vault" Content="Cancel" Command="{Binding CancelButtonCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Dimming Overlay for Share -->
        <!-- this is The Share button Pop up window code -->
        <Border Grid.RowSpan="2" 
                Background="#80000000"  
                ZIndex="1000"
                IsVisible="{Binding ShareOP}"/>

        <!-- Interactive Popup for Share (small "window" centered) -->
        <!-- this is The Share button Pop up window code -->
        <Border Grid.RowSpan="2"
                IsVisible="{Binding SharePOP}"
                ZIndex="1001"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1A1A1A" 
                CornerRadius="16" 
                Padding="20" 
                Width="400" Height="300">
            <StackPanel Spacing="10">
                <TextBlock Text="Share Entry" FontSize="20" Foreground="White" FontWeight="Bold"/>
                <TextBlock Text="Instructions: Select sharing options below." Foreground="#CCCCCC"/>
                <TextBox Watermark="Recipient Email" />
                <CheckBox Content="Share Password" Classes="CheckBoxP"/>
                <CheckBox Content="Share Read-Only" Classes="CheckBoxP"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="Vault" Content="Share"/>
                    <Button Classes="Vault" Content="Cancel" Command="{Binding CancelButtonCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Dimming Overlay for Change Passwords -->
        <!-- this is The CHange Passowrd Pop up window code -->
        <Border Grid.RowSpan="2" 
                Background="#80000000"  
                IsVisible="{Binding ChangePasswordOP}"
                ZIndex="1000"/>

        <!-- Interactive Popup for Change Passwords (small "window" centered) -->
        <!-- this is The CHange Passowrd Pop up window code -->
        <Border Grid.RowSpan="2"
                IsVisible="{Binding ChangePasswordPOP}" 
                ZIndex="1001"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1A1A1A" 
                CornerRadius="16" 
                Padding="20" 
                Width="400" Height="300">
            <StackPanel Spacing="10">
                <TextBlock Text="Change Passwords (BETA)" FontSize="20" Foreground="White" FontWeight="Bold"/>
                <TextBlock Text="Instructions: Select entries to update." Foreground="#CCCCCC"/>
                <TextBlock Text="Warning: This is beta functionality." Foreground="#FF8C00"/>
                <ComboBox PlaceholderText="Select Entry" />
                <TextBox Watermark="New Password" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="Vault" Content="Update"/>
                    <Button Classes="Vault" Content="Cancel" Command="{Binding CancelButtonCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>