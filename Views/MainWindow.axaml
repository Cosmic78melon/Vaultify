<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Password_Manager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:icons="using:FluentIcons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="600"
        x:Class="Password_Manager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Password_Manager">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    <Grid ColumnDefinitions="Auto, *" Background="{DynamicResource Primary_SideMenu_Color}">
        <ContentControl Grid.Column="1 " Foreground="{DynamicResource Primary_Button_Foreground}"
                        Content="{Binding CurrentPage}"/>
        <!-- ===================== -->
        <!-- SIDEBAR (Dark Black) -->
        <!-- ===================== -->
        <Border Grid.Column="0" Background="{DynamicResource Primary_SideMenu_Color}" CornerRadius="0,12,0,0">
            <Grid RowDefinitions="Auto,*,Auto">
              
                <!-- Top: App Branding -->
                <StackPanel Grid.Row="0" Margin="24,32,24,16" Spacing="8" PointerPressed="DoubleClicked">
                    <Image Source="/Assets/avalonia-logo.ico" Height="{Binding IconSize}"  Margin="0,-8,0,0"/>
                </StackPanel>
              
                <!-- Navigation Menu -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,0">
                    <StackPanel Spacing="4" Margin="12,0">

                        <!-- Home -->
                        <Button Command="{Binding GoToHomeCommand}"
                                Classes.active="{Binding HomePageActive}">
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="10,14">
                                <icons:SymbolIcon Symbol="Board" FontSize="20"/>
                                <Label FontSize="16" IsVisible="{Binding IsExpanded}" VerticalAlignment="Center">Home</Label>
                            </StackPanel>
                        </Button>
                      

                        <!-- Vault -->
                        <Button Command="{Binding GoToAll_EntriesCommand}"
                                Classes.active="{Binding All_EntriesActive}">
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="10,14">
                                <icons:SymbolIcon Symbol="Key" FontSize="20"/>
                                <Label FontSize="16" IsVisible="{Binding IsExpanded}" FontWeight="SemiBold" VerticalAlignment="Center">Passwords</Label>
                            </StackPanel>
                        </Button>
                      
                        <!-- Secure Notes -->
                        <Button Command="{Binding GoToSecurityCommand}"
                                Classes.active="{Binding SecurityNotesActive}">
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="10,14">
                                <icons:SymbolIcon Symbol="Note" FontSize="20"/>
                                <Label IsVisible="{Binding IsExpanded}" FontSize="16" VerticalAlignment="Center">Secure Notes</Label>
                            </StackPanel>
                        </Button>
                      
                        <!-- SECURITY TOOLS Header -->
                        <TextBlock Text="TOOLS"
                                   Foreground="#555555"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="10,32,10,8"/>
                                              
                        <!-- Personal Info -->
                        <Button Command="{Binding GoToAccountsCommand}" 
                                Classes.active="{Binding AccountPageActive}">
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="10,14">
                                <icons:SymbolIcon Symbol="Person" FontSize="20"/>
                                <Label IsVisible="{Binding IsExpanded}" FontSize="16" VerticalAlignment="Center">Personal Info</Label>
                            </StackPanel>
                        </Button>
                      
                        <!-- Settings Center -->
                        <Button Command="{Binding GoToSettingsCommand}" Classes.active="{Binding SettingsPageActive}">
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="10,14">
                                <icons:SymbolIcon Symbol="Settings" FontSize="20"/>
                                <Label IsVisible="{Binding IsExpanded}" FontSize="16" VerticalAlignment="Center">Settings</Label>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
              
                <!-- Bottom: Account -->
                <StackPanel Grid.Row="2" Margin="24,16">
                    <Border Background="#1E1E1E" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Created by: " Foreground="#AAAAAA" FontSize="14"/>
                            <TextBlock Text="Tamjid Hossian Adol" Foreground="#CCCCCC" IsVisible="{Binding IsExpanded}" FontSize="15" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                  
                    <!-- Premium Plan -->
                    <Border Background="#1E1E1E" CornerRadius="8" Padding="16" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <icons:SymbolIcon Symbol="Star" Foreground="#FF8C00" FontSize="20"/>
                            <TextBlock Text="Your plan: Premium" Foreground="#FF8C00" IsVisible="{Binding IsExpanded}" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

<!-- Background overlay -->
<Border Grid.ColumnSpan="2" Grid.Column="0"
        IsVisible="{Binding BgPop}"
        Background="#80000000"
        ZIndex="1000"/>

<!-- Centered Login Card -->
<Grid Grid.ColumnSpan="2" Grid.Column="0"
      IsVisible="{Binding BgOp}"
      ZIndex="1001">

    <Border Width="420"
            Padding="30"
            Background="{DynamicResource Primary_Background_Color}"
            CornerRadius="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BoxShadow="0 10 30 #40000000">

        <StackPanel Spacing="18">

            <!-- Title -->
            <TextBlock Text="Login"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Password Manager"
                       FontSize="16"
                       Foreground="#cccccc"
                       HorizontalAlignment="Center"/>

            <Separator Margin="0,10"/>

            <!-- Password Label -->
            <TextBlock Text="Password"
                       FontSize="14"
                       Foreground="#dddddd"/>
            
            <StackPanel Orientation="Horizontal">
                <!-- Input -->
                <TextBox Watermark="Enter your password"
                         PasswordChar="*"
                         RevealPassword="{Binding RevealPass}"
                         Height="40"
                         Width="330"
                         Padding="10"
                         BorderBrush="#444"
                         CornerRadius="8"
                         Text="{Binding Password}"/>
                <Button Background="Transparent"
                        Command="{Binding RevealPasswordCommand}"
                        Height="40"
                        Width="50">
                    <icons:SymbolIcon Symbol="{Binding EyeIcon}"></icons:SymbolIcon>
                </Button>
            </StackPanel>

            <!-- Status -->
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{Binding ColorsC}"
                       FontSize="12"/>

            <!-- Buttons -->
            <StackPanel Spacing="10" Margin="0,10,0,0">

                <Button Content="Sign In"
                        Height="45"
                        CornerRadius="10"
                        Classes="CardButton"
                        IsDefault="True"
                        FontWeight="SemiBold"
                        Command="{Binding LoginCommandCommand}"/>

                <Button Content="Create Account"
                        Height="40"
                        CornerRadius="10"
                        BorderBrush="#666"
                        BorderThickness="1"
                        Classes="CardButton"
                        Command="{Binding GotRegisterCommand}"/>

            </StackPanel>

        </StackPanel>
    </Border>
</Grid>
        <!-- this is The Register Pop up window code -->
        <Border Grid.ColumnSpan="2" Grid.Column="0"
                IsVisible="{Binding BgOpSignUp}"
                Background="#80000000"
                ZIndex="1000"/>
        <!-- Interactive Popup for Add New (small "window" centered) -->
        <Border Grid.ColumnSpan="2" Grid.Column="0"
                ZIndex="1001"
                IsVisible="{Binding BgPopSignUp}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="#1A1A1A"
                CornerRadius="16"
                Padding="20">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <TextBlock Text="Register Form" Margin="200, 0, 220, 0" FontSize="20" Foreground="White" FontWeight="Bold"/>
                <TextBlock Text="UserName" Foreground="#CCCCCC"/>
                <TextBox KeyDown="TextBoxKeyDown" Watermark="Cruid55mustard7oil, technoblade etc." Text="{Binding UserName}"/>
                <TextBlock Text="Email address" Foreground="#CCCCCC"/>
                <TextBox KeyDown="TextBoxKeyDown" Watermark="Your Email" Text="{Binding Email}"/>
                <TextBlock Text="Passoword" Foreground="#CCCCCC"/>
                <TextBox KeyDown="TextBoxKeyDown" Watermark="Password" PasswordChar="*" Text="{Binding Password}"/>
                <TextBlock Text="Confirm Passoword" Foreground="#CCCCCC"/>
                <TextBox KeyDown="TextBoxKeyDown" Watermark="Confirm Password" PasswordChar="*" Text="{Binding ConfirmationPassword}"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding ColorsC}"/>
                <Button HorizontalAlignment="Center"  Background="Orange" Content="Sign Up" Command="{Binding RegisterCommand}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="30">
                    <TextBlock Foreground="White" FontSize="20">Have an Account!!!</TextBlock>
                    <Button Background="Orange" Content="Got to Login page" Command="{Binding GotLoginCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>