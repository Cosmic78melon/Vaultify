<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Vaultify.ViewModels"
             xmlns:icons="using:FluentIcons.Avalonia"
             mc:Ignorable="d"
             d:DesignWidth="1700"
             d:DesignHeight="800"
             x:DataType="vm:All_EntriesPageViewModel"
             Background="{DynamicResource Primary_Background_Color}"
             Foreground="{DynamicResource Primary_Button_Foreground}"
             x:Class="Vaultify.Views.All_EntriesPageView">

    <Grid ColumnDefinitions="*" RowDefinitions="Auto,*">

        <!-- Main Content Area -->
        <Grid Grid.Row="0" RowDefinitions="Auto,*" Margin="0">

            <!-- Top Bar -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  Margin="32,28,32,12">

                <!-- Title -->
                <TextBlock Grid.Column="0"
                           Text="Your Passwords"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>

                <!-- Search -->
                <TextBox Grid.Column="1" Width="600"
                         Height="40"
                         Text="{Binding SearchText}"
                         HorizontalAlignment="Center"
                         Watermark="Search passwords..."
                         VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <Button Classes="Vault" Command="{Binding AddnewPopButtonCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SymbolIcon Symbol="Add" FontSize="20" />
                            <TextBlock Text="Add new" />
                        </StackPanel>
                    </Button>

                    <Button Classes="Vault" Command="{Binding SharePopButtonCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SymbolIcon Symbol="ArrowExportUp" FontSize="20" />
                            <TextBlock Text="Export Vault" />
                        </StackPanel>
                    </Button>

                    <Button Classes="Vault" Command="{Binding ChangePasswordPOPButtonCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SymbolIcon Symbol="ArrowSync" FontSize="20" />
                            <TextBlock Text="Import Vault" />
                            <Border Background="#FF8C00"
                                    CornerRadius="6"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="BETA"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="White" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Passwords Table Container -->
            <Border Grid.Row="1"
                    Margin="32,0,32,32"
                    Background="#1A1A1A"
                    CornerRadius="16"
                    ClipToBounds="True">

                <DockPanel LastChildFill="True">

                    <!-- Header – always stays at top -->
                    <Grid x:Name="HeaderGrid"
                          DockPanel.Dock="Top"
                          ColumnDefinitions="2.2*, 2*, 1.5*, 1.3*, 1.5*, 50"
                          Height="56"
                          Background="#222222">

                        <TextBlock Grid.Column="0"
                                   Text="Site / App"    
                                   Classes="Headers"
                                   Margin="16,0,8,0" />

                        <TextBlock Grid.Column="1"
                                   Text="Username" 
                                   Classes="Headers"
                                   Margin="16,0,8,0" />

                        <TextBlock Grid.Column="2"
                                   Text="Password"
                                   Classes="Headers"
                                   Margin="16,0,8,0" />

                        <TextBlock Grid.Column="3"
                                   Text="Strength"
                                   Classes="Headers"
                                   Margin="16,0,8,0" />

                        <TextBlock Grid.Column="4"
                                   Text="Password Created"
                                   Classes="Headers"
                                   Margin="16,0,8,0" />

                        <TextBlock Grid.Column="5" Text="" />
                    </Grid>


                    <!-- Scrollable list -->
                    <ListBox Background="Transparent"
                             x:Name="ListBoxData"
                             ItemsSource="{Binding FilteredItems}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="2.1*, 2*, 1.5*, 1.3*, 1.5*, 50"
                                      Background="Transparent"
                                      Margin="0,0,0,1">

                                    <!-- Hover highlight -->
                                    <Border Grid.ColumnSpan="5"
                                            Background="#252525"
                                            IsVisible="{Binding $self.IsPointerOver}"
                                            Opacity="0.6"
                                            CornerRadius="4" />

                                    <!-- Icon + Site/App -->
                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="16,12,8,12"
                                                Spacing="12">
                                        <icons:SymbolIcon Symbol="Globe"
                                                          FontSize="20"
                                                          Foreground="#4DA6FF" />
                                        <TextBlock Text="{Binding Title}"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Username}"
                                               Margin="16,12,8,12"
                                               VerticalAlignment="Center"
                                               Foreground="White"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Password}"
                                               Margin="16,12,8,12"
                                               VerticalAlignment="Center"
                                               Foreground="#D0D0D0"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Strength}"
                                               Margin="16,12,8,12"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding ColorS}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />

                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Time}"
                                               Margin="16,12,8,12"
                                               VerticalAlignment="Center"
                                               Foreground="#BBBBBB"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />

                                    <!-- Actions column (empty for now) -->
                                    <StackPanel Grid.Column="5"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="8" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <!-- Selection & hover styles -->
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="#2A2A3A" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#252535" />
                            </Style>
                        </ListBox.Styles>
                        
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Delete" Command="{Binding DeleteItemCommand}" CommandParameter="{Binding $parent[ListBox].SelectedItem}"></MenuItem>
                                <MenuItem Header="Copy Username" Command="{Binding CopyUsernameCommand}" CommandParameter="{Binding $parent[ListBox].SelectedItem}"></MenuItem>
                                <MenuItem Header="Copy Password" Command="{Binding CopyPasswordCommand}" CommandParameter="{Binding $parent[ListBox].SelectedItem}"></MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding AddnewOP}"
                Background="Black"
                ZIndex="1000" />

        <Border Grid.Row="0" Grid.RowSpan="2"
                ZIndex="1001"
                IsVisible="{Binding AddnewPOP}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1A1A1A"
                CornerRadius="16"
                Padding="24"
                Width="600"
                Height="460">
            <StackPanel Spacing="16">
                <TextBlock Text="Add New Entry"
                           FontSize="22"
                           Foreground="White"
                           FontWeight="Bold" />
                <TextBlock Text="Enter the details below"
                           Foreground="#BBBBBB"
                           FontSize="14" />
                <TextBox KeyDown="TextBox_KeyDown" Watermark="Website / App / Service (e.g. example.com)"
                         Text="{Binding Webname}" />
                <TextBox KeyDown="TextBox_KeyDown" Watermark="Username / Email"
                         Text="{Binding Name}" />
                <TextBox KeyDown="TextBox_KeyDown" Watermark="Password"
                         Text="{Binding Password, Mode=TwoWay}"/>
                <TextBox KeyDown="TextBox_KeyDown" Watermark="Password"
                         Text="{Binding ConfirmationPassword, Mode=TwoWay}" />
                <TextBox KeyDown="TextBox_KeyDown" Watermark="Category (optional)"
                         Text="{Binding Catagory}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{Binding ColorC}" />
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <Button Classes="Vault" Command="{Binding GeneratePasswordCommand}" Content="Generate Password" />
                    <Button Classes="Vault"
                            Content="Save"
                            Command="{Binding saveCommand}" />
                    <Button Classes="Vault"
                            Content="Cancel"
                            Command="{Binding CancelButtonCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Share Popup -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#80000000"
                ZIndex="1000"
                IsVisible="{Binding ShareOP}" />

        <Border Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding SharePOP}"
                ZIndex="1001"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1A1A1A"
                CornerRadius="16"
                Padding="24"
                Width="440"
                Height="320">
            <StackPanel Spacing="16">
                <TextBlock Text="Export Entries"
                           FontSize="22"
                           Foreground="White"
                           FontWeight="Bold" />
                <ComboBox PlaceholderText="Select File Type"
                ItemsSource="{Binding Categories}"
                IsEditable="False"
                SelectedItem="{Binding SelectedItem}">
                    <ComboBox.DataTemplates>
                        <DataTemplate DataType="vm:FileType">
                            <StackPanel Orientation="Horizontal">
                                <icons:SymbolIcon Symbol="{Binding Icons}"></icons:SymbolIcon>
                                <TextBlock Text="{Binding Name}"></TextBlock>
                                <TextBlock Text="("></TextBlock>
                                <TextBlock Text="{Binding Extension}"></TextBlock>
                                <TextBlock Text=")"></TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.DataTemplates>
                </ComboBox>
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            HorizontalAlignment="Right"
                            Margin="0,10,05,08">
                    <Button Classes="Vault" Content="Save as" Command="{Binding SaveFileCommand}"/>
                    <Button Classes="Vault"
                            Content="Cancel"
                            Command="{Binding CancelButtonCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Change Password Popup -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#80000000"
                ZIndex="1000"
                IsVisible="{Binding ChangePasswordOP}" />

        <Border Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding ChangePasswordPOP}"
                ZIndex="1001"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1A1A1A"
                CornerRadius="16"
                Padding="24"
                Width="460"
                Height="340">
            <StackPanel Spacing="16">
                <TextBlock Text="Change Passwords (BETA)"
                           FontSize="22"
                           Foreground="White"
                           FontWeight="Bold" />
                <TextBlock Text="Warning: Experimental feature"
                           Foreground="#FF8C00"
                           FontWeight="SemiBold" />
                <ComboBox PlaceholderText="Select entry to update">
                </ComboBox>
                <TextBox Watermark="New Password" />
                <TextBox Watermark="Confirm New Password" />
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button Classes="Vault" Content="Update" />
                    <Button Classes="Vault"
                            Content="Cancel"
                            Command="{Binding CancelButtonCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- Confirm Delete Popup -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#80000000"
                ZIndex="1000"
                IsVisible="{Binding ConfimationDialog}" />

        <Border Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding ConfimationDialog}"
                ZIndex="1001"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1A1A1A"
                CornerRadius="16"
                Padding="24"
                Width="460"
                Height="340">
            <StackPanel Spacing="16">
                <TextBlock Text="Are you sure??"
                           FontSize="22"
                           Foreground="White"
                           FontWeight="Bold" />
                <TextBlock Text="Warning: Experimental feature"
                           Foreground="#FF8C00"
                           FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button Content="Yes" Background="Green" Foreground="Black" BorderThickness="1" BorderBrush="AliceBlue" Command="{Binding yesButtonCommand }"/>
                    <Button Background="Red" Foreground="Black" BorderThickness="1" BorderBrush="AliceBlue"
                            Content="Cancel"
                            Command="{Binding CancelButtonCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>