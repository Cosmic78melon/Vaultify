<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:Password_Manager.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1700" d:DesignHeight="800"
             xmlns:icons="using:FluentIcons.Avalonia"
             x:DataType="viewmodels:All_EntriesPageViewModel"
             Background="#0A0A0A"
             x:Class="Password_Manager.All_EntriesPageView">

    <!-- Main Layout: Sidebar + Content (Black & Orange Theme) -->
    <Grid ColumnDefinitions="*" RowDefinitions="Auto,*">
       
        <!-- ===================== -->
        <!-- MAIN CONTENT (Black & Orange) -->
        <!-- ===================== -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,0,0">
           
            <!-- Top Bar -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="32,28,32,12">
               
                <!-- Page Title -->
                <TextBlock Text="Your Passwords"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
               
                <!-- Action Buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                   
                    <!-- Add New -->
                    <Button Classes="Vault" Command="{Binding AddnewPOPButtonCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SymbolIcon Symbol="Add" FontSize="20"/>
                            <TextBlock Text="Add new"/>
                        </StackPanel>
                    </Button>
                   
                    <!-- Share -->
                    <Button Classes="Vault" Command="{Binding SharePOPButtonCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SymbolIcon Symbol="Share" FontSize="20"/>
                            <TextBlock Text="Share"/>
                        </StackPanel>
                    </Button>
                   
                    <!-- Change passwords -->
                    <Button Classes="Vault" Command="{Binding ChangePasswordPOPButtonCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:SymbolIcon Symbol="ArrowSync" FontSize="20"/>
                            <TextBlock Text="Change passwords"/>
                            <Border Background="#FF8C00"
                                    CornerRadius="6"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="BETA"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Button>
                   
                </StackPanel>
               
            </Grid>
           
            <!-- Passwords Table -->
            <Border Grid.Row="1"
                    Margin="32,0,32,32"
                    Background="#1A1A1A"
                    CornerRadius="16"
                    ClipToBounds="True">
               
                <Grid>
                   
                    <!-- Table Header -->
                    <Grid Grid.Row="0"
                          ColumnDefinitions="72,*,220,160,140,80"
                          Height="56"
                          Background="#222222"
                          VerticalAlignment="Top">
                       
                        <!-- Icon Column -->
                        <TextBlock Grid.Column="0"
                                   Text=""
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="#777777"/>
                       
                        <!-- Name -->
                        <TextBlock Grid.Column="1"
                                   Text="NAME"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#777777"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,0"/>
                       
                        <!-- Email (sub) -->
                        <TextBlock Grid.Column="1"
                                   Text=""
                                   FontSize="14"
                                   Foreground="#777777"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,0"/>
                       
                        <!-- Category -->
                        <TextBlock Grid.Column="2"
                                   Text="CATEGORY"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#777777"
                                   VerticalAlignment="Center"/>
                       
                        <!-- Last Used -->
                        <TextBlock Grid.Column="3"
                                   Text="LAST USED"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#777777"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,32,0"/>
                       
                        <!-- Actions -->
                        <TextBlock Grid.Column="4"
                                   Text=""
                                   FontSize="14"
                                   Foreground="#777777"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,24,0"/>
                       
                    </Grid>
                   
                    <!-- Scrollable Entries -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,56,0,0">
                       
                        <StackPanel>
                           
                            <!-- Entry 1: Acer -->
                            <Grid ColumnDefinitions="72,*,220,160,140,80" Height="68" Background="Transparent">
                                <Border Grid.Column="0" Width="42" Height="42" Background="#4CAF50" CornerRadius="10" Margin="16,13,0,13">
                                    <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="20"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,13,0,13" VerticalAlignment="Center">
                                    <TextBlock Text="acer.com" FontSize="17" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="danielle@email.com" FontSize="13" Foreground="#999999" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" HorizontalAlignment="Left" Margin="0,17,0,17" Background="#2A2A2A" CornerRadius="20" Padding="18,6">
                                    <TextBlock Text="Tech" FontSize="14" Foreground="#CCCCCC" FontWeight="Medium"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="3 years ago" VerticalAlignment="Center" FontSize="15" Foreground="#999999" HorizontalAlignment="Right" Margin="0,0,32,0"/>
                                <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="12" HorizontalAlignment="Right" Margin="0,0,16,0">
                                    <icons:SymbolIcon Symbol="MoreHorizontal" Foreground="#777777" FontSize="22"/>
                                </Button>
                            </Grid>
                            <Separator Background="#252525" Height="1" Margin="16,0"/>
                           
                            <!-- Entry 2: Adobe -->
                            <Grid ColumnDefinitions="72,*,220,160,140,80" Height="68" Background="Transparent">
                                <Border Grid.Column="0" Width="42" Height="42" Background="#F44336" CornerRadius="10" Margin="16,13,0,13">
                                    <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="20"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,13,0,13" VerticalAlignment="Center">
                                    <TextBlock Text="adobe.com" FontSize="17" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="danielle@email.com" FontSize="13" Foreground="#999999" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" HorizontalAlignment="Left" Margin="0,17,0,17" Background="#2A2A2A" CornerRadius="20" Padding="18,6">
                                    <TextBlock Text="Business" FontSize="14" Foreground="#CCCCCC" FontWeight="Medium"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="3 weeks ago" VerticalAlignment="Center" FontSize="15" Foreground="#999999" HorizontalAlignment="Right" Margin="0,0,32,0"/>
                                <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="12" HorizontalAlignment="Right" Margin="0,0,16,0">
                                    <icons:SymbolIcon Symbol="MoreHorizontal" Foreground="#777777" FontSize="22"/>
                                </Button>
                            </Grid>
                            <Separator Background="#252525" Height="1" Margin="16,0"/>
                           
                            <!-- Entry 3: Airbnb -->
                            <Grid ColumnDefinitions="72,*,220,160,140,80" Height="68" Background="Transparent">
                                <Border Grid.Column="0" Width="42" Height="42" Background="#FF4081" CornerRadius="10" Margin="16,13,0,13">
                                    <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="20"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,13,0,13" VerticalAlignment="Center">
                                    <TextBlock Text="airbnb.com" FontSize="17" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="danielle@email.com" FontSize="13" Foreground="#999999" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" HorizontalAlignment="Left" Margin="0,17,0,17" Background="#2A2A2A" CornerRadius="20" Padding="18,6">
                                    <TextBlock Text="Travel" FontSize="14" Foreground="#CCCCCC" FontWeight="Medium"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="6 days ago" VerticalAlignment="Center" FontSize="15" Foreground="#999999" HorizontalAlignment="Right" Margin="0,0,32,0"/>
                                <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="12" HorizontalAlignment="Right" Margin="0,0,16,0">
                                    <icons:SymbolIcon Symbol="MoreHorizontal" Foreground="#777777" FontSize="22"/>
                                </Button>
                            </Grid>
                            <Separator Background="#252525" Height="1" Margin="16,0"/>
                           
                            <!-- Entry 4: Amazon -->
                            <Grid ColumnDefinitions="72,*,220,160,140,80" Height="68" Background="Transparent">
                                <Border Grid.Column="0" Width="42" Height="42" Background="#FF9800" CornerRadius="10" Margin="16,13,0,13">
                                    <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="20"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,13,0,13" VerticalAlignment="Center">
