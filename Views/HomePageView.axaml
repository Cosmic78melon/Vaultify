<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vw="using:Password_Manager.ViewModels"
             mc:Ignorable="d"
             x:DataType="vw:HomePageViewModel"
             d:DesignWidth="1700"
             d:DesignHeight="800"
             xmlns:icons="using:FluentIcons.Avalonia"
             Foreground="{DynamicResource Primary_Button_Foreground}"
             Background="{DynamicResource Primary_Background_Color}"
             x:Class="Password_Manager.HomePageView">

    <!-- Main Layout -->
    <Grid RowDefinitions="Auto,Auto,Auto,auto, *"
          Margin="10">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              Margin="0,0,0,5">

            <Label FontSize="30"
                   Margin="10, 0, -110, 0"
                   VerticalAlignment="Center"
                   Content="Main"/>

            <TextBox Grid.Column="1"
                     Width="600"
                     HorizontalAlignment="Center"
                     Watermark="Search"
                     CornerRadius="7"/>
        </Grid>

        <!-- Top Separator -->
        <Separator Grid.Row="1"/>

        <!-- Cards Area -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,Auto,Auto"
              ColumnSpacing="30">

            <!-- ===================== -->
            <!-- Recent Card -->
            <!-- ===================== -->
            <Border Classes="Card" 
                    Height="350"
                    Margin="10, 27, 0, 0"
                    HorizontalAlignment="Left">

                <Grid RowDefinitions="Auto,*"
                      Margin="20">

                    <Label FontSize="20"
                           Foreground="Orange"
                           Content="Recent"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Google" Foreground="#d4d4d4" Margin="0,7"/>
                                <Border Grid.Column="1"
                                        CornerRadius="10"
                                        Padding="8,2">
                                    <TextBlock Text="2"
                                               FontSize="30"
                                               Foreground="#666666"
                                               FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Separator Classes="CardSep"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Facebook" Foreground="#d4d4d4" Margin="0,7"/>
                                <Border Grid.Column="1"
                                        CornerRadius="10"
                                        Padding="8,2">
                                    <TextBlock Text="1"
                                               FontSize="30"
                                               Foreground="#666666"
                                               FontWeight="Bold"/>
                                </Border>
                            </Grid>
                            <Separator Classes="CardSep"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Youtube" Foreground="#d4d4d4" Margin="0,7"/>
                                <Border Grid.Column="1"
                                        CornerRadius="10"
                                        Padding="8,2">
                                    <TextBlock Text="1"
                                               FontSize="30"
                                               Foreground="#666666"
                                               FontWeight="Bold"/>
                                </Border>
                            </Grid>
                            <Separator Classes="CardSep"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Instagram" Foreground="#d4d4d4" Margin="0,7"/>
                                <Border Grid.Column="1"
                                        CornerRadius="10"
                                        Padding="8,2">
                                    <TextBlock Text="5"
                                               FontSize="30"
                                               Foreground="#666666"
                                               FontWeight="Bold"/>
                                </Border>
                            </Grid>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>
            </Border>


            <!-- ===================== -->
            <!-- Favourite Card -->
            <!-- ===================== -->
            <Border Grid.Column="1"
                    Height="350"
                    Margin="0, 27, 0, 0"
                    HorizontalAlignment="Stretch" Classes="Card">

                <Grid RowDefinitions="Auto,*"
                      Margin="10">

                    <Label FontSize="20"
                           Margin="10 7 0 05"
                           Foreground="Orange"
                           Content="Favourite"/>

                    <ScrollViewer Grid.Row="1"
                                  Margin="10 0 10 -10"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Bank LTD." Foreground="#d4d4d4" Margin="0,7"/>
                                <Border Grid.Column="1"
                                        CornerRadius="10"
                                        Padding="8,2">
                                    <TextBlock Text="10"
                                               FontSize="30"
                                               Foreground="#666666"
                                               FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Separator Classes="CardSep"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Minecraft" Foreground="#d4d4d4" Margin="0,7"/>
                                <Border Grid.Column="1"
                                        CornerRadius="10"
                                        Padding="8,2">
                                    <TextBlock Text="1"
                                               FontSize="30"
                                               Foreground="#666666"
                                               FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Separator Classes="CardSep"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Ubisoft" Foreground="#d4d4d4" Margin="0,7"/>
                                <Border Grid.Column="1"
                                        CornerRadius="10"
                                        Padding="8,2">
                                    <TextBlock Text="1"
                                               FontSize="30"
                                               Foreground="#666666"
                                               FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Separator Classes="CardSep"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Steam" Foreground="#d4d4d4" Margin="0,7"/>
                                <Border Grid.Column="1"
                                        CornerRadius="10"
                                        Padding="8,2">
                                    <TextBlock Text="1"
                                               FontSize="30"
                                               Foreground="#666666"
                                               FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Separator Classes="CardSep"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Epic Games" Foreground="#d4d4d4" Margin="0,7"/>
                                <Border Grid.Column="1"
                                        CornerRadius="10"
                                        Padding="8,2">
                                    <TextBlock Text="3"
                                               FontSize="30"
                                               Foreground="#666666"
                                               FontWeight="Bold"/>
                                </Border>
                            </Grid>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>
            </Border>
            
        <!-- ===================== -->
        <!-- Password Generator Card -->
        <!-- ===================== -->
        <Border Grid.Column="2"
                Margin="0, 37, 0, 0"
                Classes="Card"
                Height="350"
                Width="555"
                HorizontalAlignment="Stretch">

            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
                  Margin="20"
                  RowSpacing="10">

                <Label Content="Password Generator"
                       FontSize="20"
                       Foreground="Orange"/>

                <TextBox Grid.Row="1"
                         Text="{Binding PasswordGenerator, Mode=OneWay}"
                         IsReadOnly="True"
                         CornerRadius="7"/>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Spacing="10">

                    <TextBlock Text="Length:"
                               VerticalAlignment="Center"/>

                    <Slider Minimum="12"
                            Maximum="64"
                            x:Name="slider"
                            Value="{Binding Lenght}"
                            Width="360"/>

                    <TextBlock Text="{Binding #slider.Value}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="3"
                            Spacing="5">

                    <CheckBox Classes="CheckBoxP" Content="Include Letters" IsChecked="{Binding HasLetterCase}"/>
                    <CheckBox Classes="CheckBoxP" Content="Include Numbers" IsChecked="{Binding HasNumCase}"/>
                    <CheckBox Classes="CheckBoxP" Content="Include Symbols" IsChecked="{Binding HasPuncCase}"/>
                </StackPanel>

               <Button Grid.Row="4"
                    Command="{Binding GeneratePasswordCommand}"
                    Height="45"
                    Foreground="White"
                    Classes="CardButton">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
					<icons:SymbolIcon Symbol="Markdown"></icons:SymbolIcon>
                    <Label Foreground="White">Generate Password</Label>
                </StackPanel>
            </Button>
    </Grid>
</Border>


        </Grid>

        <Separator Grid.Row="3" Margin="10, 19"/>
        <!-- Cards Area -->
        <Grid Grid.Row="4"
              ColumnDefinitions="auto,Auto"
              ColumnSpacing="30">

            <!-- ===================== -->
            <!-- Status Card -->
            <!-- ===================== -->
            <Border Classes="Card" HorizontalAlignment="Left"
                    Width="1000"
                                  VerticalAlignment="Top">

                <Grid Grid.ColumnSpan="1" Grid.ColumnDefinitions="Auto, auto, auto" RowDefinitions="Auto,auto,*"
                      Margin="10">

                    <Label FontSize="20"
                           Foreground="Orange"
                           Content="Status"/>
                    <Separator Grid.Row="1" Margin="0 0 -95 0"></Separator>
                    <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Horizontal">
                        <StackPanel>
						        <TextBlock Classes="status_Text"><LineBreak/><Span Foreground="CornflowerBlue" FontSize="60" FontFamily="Arial Bold">0</Span>  <LineBreak/>Saved Passwords</TextBlock>
                        </StackPanel>
                    <Separator Classes="Vertical_Seperator"></Separator>
                    <StackPanel>
					    <TextBlock Classes="status_Text"><LineBreak/> <Span Foreground="ForestGreen" FontSize="60" FontFamily="Arial Bold">0</Span>  <LineBreak/>Strong Passwords</TextBlock>
                    </StackPanel>
                    <Separator Classes="Vertical_Seperator"></Separator>

                    <StackPanel>
						   <TextBlock Classes="status_Text"><LineBreak/><Span Foreground="Red" FontSize="60" FontFamily="Arial Bold">0</Span>  <LineBreak/>Weak Passwords</TextBlock>
                    </StackPanel>
                    <Separator Classes="Vertical_Seperator"></Separator>
                    <StackPanel>
						   <TextBlock Classes="status_Text"><LineBreak/><Span Foreground="Yellow" FontSize="60" FontFamily="Arial Bold">0</Span>  <LineBreak/>Duplicate</TextBlock>
                    </StackPanel>
                    </StackPanel>

                </Grid>
            </Border>
            
        <!-- ===================== -->
        <!-- Password Strength check Card -->
        <!-- ===================== -->
            <Border Grid.Column="2"
            Margin="0"
            Classes="Card"
            Height="400"
            Width="600"
            VerticalAlignment="Top">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"  
              Margin="18"
              RowSpacing="10">

            <Label Content="Password Strength checker"
                   FontSize="20"
                   Foreground="Orange"/>

            <TextBox Grid.Row="1"
                     Watermark="Enter your password"
                     Text="{Binding PasswordHaveToCheck}"
                     CornerRadius="7"/>

            <!-- Replace StackPanel with Grid for better vertical distribution -->
            <Grid Grid.Row="3"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                <TextBlock Grid.Row="0" Text="{Binding Password_result}" Foreground="{Binding FontC}" FontSize="20" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="{Binding HasUpper}" Foreground="{Binding Font1}" FontSize="20" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="2" Text="{Binding HasLower}" Foreground="{Binding Font2}" FontSize="20" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="3" Text="{Binding HasNum}" Foreground="{Binding Font3}"  FontSize="20"  TextWrapping="Wrap"/>
                <TextBlock Grid.Row="4" Text="{Binding HasPunc}" Foreground="{Binding Font4}"  FontSize="20"  TextWrapping="Wrap"/>
                <TextBlock Grid.Row="5" Text="{Binding Islong}" Foreground="{Binding Font5}"  FontSize="20"  TextWrapping="Wrap"/>
            </Grid>

            <Button Grid.Row="4"
                    Command="{Binding PasswordCheckerCommand}"
                    Height="45"
                    Foreground="White"
                    Classes="CardButton">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
					<icons:SymbolIcon Symbol="Markdown"></icons:SymbolIcon>
                    <Label Foreground="White">Check Password</Label>
                </StackPanel>
            </Button>
        </Grid>
    </Border>


        </Grid>

    </Grid>

</UserControl>
