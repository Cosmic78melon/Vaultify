<UserControl
    Background="{DynamicResource Primary_Background_Color}"
    Foreground="{DynamicResource Primary_Button_Foreground}"
    d:DesignHeight="800"
    d:DesignWidth="1700"
    mc:Ignorable="d"
    x:Class="Vaultify.Views.All_EntriesPageView"
    x:DataType="vm:All_EntriesPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Vaultify.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid ColumnDefinitions="*" RowDefinitions="Auto,*">

        <!--  Top Bar  -->
        <Grid
            ColumnDefinitions="Auto,*,Auto"
            Grid.Row="0"
            Margin="32,28,32,12">

            <!--  Title  -->
            <TextBlock
                FontSize="34"
                FontWeight="Bold"
                Foreground="White"
                Grid.Column="0"
                Margin="0,0,24,0"
                Text="Your Passwords"
                VerticalAlignment="Center" />

            <!--  Search  -->
            <TextBox
                Grid.Column="1"
                Height="40"
                HorizontalAlignment="Stretch"
                Margin="0,0,10,0"
                Text="{Binding SearchText}"
                VerticalAlignment="Center"
                Watermark="Search passwords..." />

            <!--  Buttons  -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="12"
                VerticalAlignment="Center">

                <Button Classes="Vault" Command="{Binding AddnewPopButtonCommand}">

                    <StackPanel Orientation="Horizontal" Spacing="10">

                        <icons:SymbolIcon FontSize="20" Symbol="Add" />

                        <TextBlock Text="Add new" />

                    </StackPanel>
                </Button>

                <Button Classes="Vault" Command="{Binding SharePopButtonCommand}">

                    <StackPanel Orientation="Horizontal" Spacing="10">

                        <icons:SymbolIcon FontSize="20" Symbol="ArrowExportUp" />

                        <TextBlock Text="Export Vault" />

                    </StackPanel>
                </Button>

                <Button Classes="Vault" Command="{Binding ChangePasswordPOPButtonCommand}">

                    <StackPanel Orientation="Horizontal" Spacing="10">

                        <icons:SymbolIcon FontSize="20" Symbol="ArrowSync" />

                        <TextBlock Text="Import Vault" />

                        <Border
                            Background="#FF8C00"
                            CornerRadius="6"
                            Padding="8,2"
                            VerticalAlignment="Center">

                            <TextBlock
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="BETA" />

                        </Border>

                    </StackPanel>
                </Button>

            </StackPanel>

        </Grid>

        <!--  Password Table  -->
        <Grid Grid.Row="1" RowDefinitions="56,*">

            <!--  Table Header  -->
            <Grid
                Background="#222222"
                ColumnDefinitions="2.2*, 2*, 1.5*, 1.3*, 1.5*, 50"
                Grid.Row="0"
                x:Name="HeaderGrid">

                <TextBlock
                    Classes="Headers"
                    Grid.Column="0"
                    Margin="16,0,8,0"
                    Text="Site / App" />

                <TextBlock
                    Classes="Headers"
                    Grid.Column="1"
                    Margin="16,0,8,0"
                    Text="Username" />

                <TextBlock
                    Classes="Headers"
                    Grid.Column="2"
                    Margin="16,0,8,0"
                    Text="Password" />

                <TextBlock
                    Classes="Headers"
                    Grid.Column="3"
                    Margin="16,0,8,0"
                    Text="Strength" />

                <TextBlock
                    Classes="Headers"
                    Grid.Column="4"
                    Margin="16,0,8,0"
                    Text="Password Created" />

                <TextBlock Grid.Column="5" />

            </Grid>

            <!--  Scrollable List  -->
            <ListBox
                Background="Transparent"
                Grid.Row="1"
                ItemsSource="{Binding FilteredItems}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                x:Name="ListBoxData">

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <Grid
                            Background="Transparent"
                            ColumnDefinitions="2.1*, 2*, 1.5*, 1.3*, 1.5*, 50"
                            Margin="0,0,0,1">

                            <!--  Hover  -->
                            <Border
                                Background="#252525"
                                CornerRadius="4"
                                Grid.ColumnSpan="6"
                                IsVisible="{Binding $self.IsPointerOver}"
                                Opacity="0.6" />

                            <!--  Site / App  -->
                            <StackPanel
                                Grid.Column="0"
                                Margin="16,12,8,12"
                                Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">

                                <icons:SymbolIcon
                                    FontSize="20"
                                    Foreground="#4DA6FF"
                                    Symbol="Globe" />

                                <TextBlock
                                    Foreground="White"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    VerticalAlignment="Center" />

                            </StackPanel>

                            <!--  Username  -->
                            <TextBlock
                                Foreground="White"
                                Grid.Column="1"
                                Margin="16,12,8,12"
                                Text="{Binding Username}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                VerticalAlignment="Center" />

                            <!--  Password  -->
                            <TextBlock
                                Foreground="#D0D0D0"
                                Grid.Column="2"
                                Margin="16,12,8,12"
                                Text="{Binding Password}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                VerticalAlignment="Center" />

                            <!--  Strength  -->
                            <TextBlock
                                Foreground="{Binding ColorS}"
                                Grid.Column="3"
                                Margin="16,12,8,12"
                                Text="{Binding Strength}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                VerticalAlignment="Center" />

                            <!--  Created  -->
                            <TextBlock
                                Foreground="#BBBBBB"
                                Grid.Column="4"
                                Margin="16,12,8,12"
                                Text="{Binding Time}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                VerticalAlignment="Center" />

                            <!--  Actions  -->
                            <StackPanel
                                Grid.Column="5"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center" />

                        </Grid>

                    </DataTemplate>
                </ListBox.ItemTemplate>

                <!--  Selection / Hover  -->
                <ListBox.Styles>

                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="#2A2A3A" />
                    </Style>

                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#252535" />
                    </Style>

                </ListBox.Styles>

                <!--  Context Menu  -->
                <ListBox.ContextMenu>
                    <ContextMenu>

                        <MenuItem
                            Command="{Binding DeleteItemCommand}"
                            CommandParameter="{Binding $parent[ListBox].SelectedItem}"
                            Header="Delete" />

                        <MenuItem
                            Command="{Binding CopyUsernameCommand}"
                            CommandParameter="{Binding $parent[ListBox].SelectedItem}"
                            Header="Copy Username" />

                        <MenuItem
                            Command="{Binding CopyPasswordCommand}"
                            CommandParameter="{Binding $parent[ListBox].SelectedItem}"
                            Header="Copy Password" />

                    </ContextMenu>
                </ListBox.ContextMenu>

            </ListBox>

        </Grid>

        <Border
            Background="Black"
            Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="{Binding AddnewOP}"
            ZIndex="1000" />

        <Border
            Background="#1A1A1A"
            CornerRadius="16"
            Grid.Row="0"
            Grid.RowSpan="2"
            Height="460"
            HorizontalAlignment="Center"
            IsVisible="{Binding AddnewPOP}"
            Padding="24"
            VerticalAlignment="Center"
            Width="600"
            ZIndex="1001">
            <StackPanel Spacing="16">
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Add New Entry" />
                <TextBlock
                    FontSize="14"
                    Foreground="#BBBBBB"
                    Text="Enter the details below" />
                <AutoCompleteBox
                    IsTextCompletionEnabled="True"
                    ItemsSource="{Binding websitesNames}"
                    KeyDown="TextBox_KeyDown"
                    SelectedItem="{Binding Selectedwebsite}"
                    Text="{Binding Webname, Mode=TwoWay}"
                    Watermark="Website / App / Service (e.g. example.com)" />
                <AutoCompleteBox
                    IsTextCompletionEnabled="True"
                    ItemsSource="{Binding userName}"
                    KeyDown="TextBox_KeyDown"
                    SelectedItem="{Binding SelecteduserName}"
                    Text="{Binding Name, Mode=TwoWay}"
                    Watermark="Username / Email" />
                <AutoCompleteBox
                    IsTextCompletionEnabled="True"
                    ItemsSource="{Binding autoCompletepassword}"
                    KeyDown="TextBox_KeyDown"
                    SelectedItem="{Binding Selectedpassword}"
                    Text="{Binding Password, Mode=TwoWay}"
                    Watermark="Password" />
                <AutoCompleteBox
                    IsTextCompletionEnabled="True"
                    ItemsSource="{Binding autoCompletepassword}"
                    KeyDown="TextBox_KeyDown"
                    SelectedItem="{Binding Selectedpassword}"
                    Text="{Binding ConfirmationPassword, Mode=TwoWay}"
                    Watermark="Password" />
                <AutoCompleteBox
                    IsTextCompletionEnabled="True"
                    ItemsSource="{Binding category}"
                    KeyDown="TextBox_KeyDown"
                    SelectedItem="{Binding Selectedcategory}"
                    Text="{Binding Catagory, Mode=TwoWay}"
                    Watermark="Category (optional)" />
                <TextBlock Foreground="{Binding ColorC}" Text="{Binding StatusMessage}" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        Classes="Vault"
                        Command="{Binding GeneratePasswordCommand}"
                        Content="Generate Password" />
                    <Button
                        Classes="Vault"
                        Command="{Binding saveCommand}"
                        Content="Save" />
                    <Button
                        Classes="Vault"
                        Command="{Binding CancelButtonCommand}"
                        Content="Cancel" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  Share Popup  -->
        <Border
            Background="#80000000"
            Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="{Binding ShareOP}"
            ZIndex="1000" />

        <Border
            Background="#1A1A1A"
            CornerRadius="16"
            Grid.Row="0"
            Grid.RowSpan="2"
            Height="320"
            HorizontalAlignment="Center"
            IsVisible="{Binding SharePOP}"
            Padding="24"
            VerticalAlignment="Center"
            Width="440"
            ZIndex="1001">
            <StackPanel Spacing="16">
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Export Entries" />
                <ComboBox
                    IsEditable="False"
                    ItemsSource="{Binding Categories}"
                    PlaceholderText="Select File Type"
                    SelectedItem="{Binding SelectedItem}">
                    <ComboBox.DataTemplates>
                        <DataTemplate DataType="vm:FileType">
                            <StackPanel Orientation="Horizontal">
                                <icons:SymbolIcon Symbol="{Binding Icons}" />
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="(" />
                                <TextBlock Text="{Binding Extension}" />
                                <TextBlock Text=")" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.DataTemplates>
                </ComboBox>
                <StackPanel
                    HorizontalAlignment="Right"
                    Margin="0,10,05,08"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        Classes="Vault"
                        Command="{Binding SaveFileCommand}"
                        Content="Save as" />
                    <Button
                        Classes="Vault"
                        Command="{Binding CancelButtonCommand}"
                        Content="Cancel" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  Change Password Popup  -->
        <Border
            Background="#80000000"
            Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="{Binding ChangePasswordOP}"
            ZIndex="1000" />

        <Border
            Background="#1A1A1A"
            CornerRadius="16"
            Grid.Row="0"
            Grid.RowSpan="2"
            Height="340"
            HorizontalAlignment="Center"
            IsVisible="{Binding ChangePasswordPOP}"
            Padding="24"
            VerticalAlignment="Center"
            Width="460"
            ZIndex="1001">
            <StackPanel Spacing="16">
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Change Passwords (BETA)" />
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="#FF8C00"
                    Text="Warning: Experimental feature" />
                <ComboBox PlaceholderText="Select entry to update" />
                <TextBox Watermark="New Password" />
                <TextBox Watermark="Confirm New Password" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button Classes="Vault" Content="Update" />
                    <Button
                        Classes="Vault"
                        Command="{Binding CancelButtonCommand}"
                        Content="Cancel" />
                </StackPanel>
            </StackPanel>
        </Border>
        <!--  Confirm Delete Popup  -->
        <Border
            Background="#80000000"
            Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="{Binding ConfimationDialog}"
            ZIndex="1000" />

        <Border
            Background="#1A1A1A"
            CornerRadius="16"
            Grid.Row="0"
            Grid.RowSpan="2"
            Height="240"
            HorizontalAlignment="Center"
            IsVisible="{Binding ConfimationDialog}"
            Padding="24"
            VerticalAlignment="Center"
            Width="460"
            ZIndex="1001">
            <StackPanel Spacing="16">
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Are you sure??" />
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="#FF8C00"
                    Text="Warning: Experimental feature" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        Background="Green"
                        BorderBrush="AliceBlue"
                        BorderThickness="1"
                        Command="{Binding yesButtonCommand}"
                        Content="Yes"
                        Foreground="Black" />
                    <Button
                        Background="Red"
                        BorderBrush="AliceBlue"
                        BorderThickness="1"
                        Command="{Binding CancelButtonCommand}"
                        Content="Cancel"
                        Foreground="Black" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>