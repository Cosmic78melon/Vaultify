<Window
    Icon="/Assets/vaultify.ico"
    Title="Vaultify"
    WindowState="Maximized"
    d:DesignHeight="600"
    d:DesignWidth="1024"
    mc:Ignorable="d"
    x:Class="Vaultify.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Vaultify.Views"
    xmlns:vm="using:Vaultify.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.DataContext>
        <!--
            This only sets the DataContext for the previewer in an IDE,
            to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
        -->
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid Background="{DynamicResource Primary_SideMenu_Color}" ColumnDefinitions="Auto, *">
        <ContentControl
            Content="{Binding CurrentPage}"
            Foreground="{DynamicResource Primary_Button_Foreground}"
            Grid.Column="1 " />

        <views:ToastNotificationView
            DataContext="{Binding Toast}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            ZIndex="999" />
        <!--  =====================  -->
        <!--  SIDEBAR (Dark Black)  -->
        <!--  =====================  -->
        <Border
            Background="{DynamicResource Primary_SideMenu_Color}"
            CornerRadius="0,12,0,0"
            Grid.Column="0">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!--  Top: App Branding  -->
                <StackPanel
                    Grid.Row="0"
                    Margin="24,32,24,16"
                    PointerPressed="DoubleClicked"
                    Spacing="8">
                    <Image
                        Height="{Binding IconSize}"
                        Margin="0,-8,0,0"
                        Source="/Assets/vaultify.ico" />
                </StackPanel>

                <Separator Grid.Row="1" Margin="0,0,0,10" />

                <!--  Navigation Menu  -->
                <ScrollViewer
                    Grid.Row="2"
                    HorizontalScrollBarVisibility="Disabled"
                    Margin="8,0"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0" Spacing="4">

                        <!--  Home  -->
                        <Button Classes.active="{Binding HomePageActive}" Command="{Binding GoToHomeCommand}">
                            <StackPanel
                                Margin="10,14"
                                Orientation="Horizontal"
                                Spacing="16">
                                <icons:SymbolIcon FontSize="20" Symbol="Board" />
                                <Label
                                    FontSize="16"
                                    IsVisible="{Binding IsExpanded}"
                                    VerticalAlignment="Center">
                                    Home
                                </Label>
                            </StackPanel>
                        </Button>


                        <!--  Vault  -->
                        <Button Classes.active="{Binding All_EntriesActive}" Command="{Binding GoToAll_EntriesCommand}">
                            <StackPanel
                                Margin="10,14"
                                Orientation="Horizontal"
                                Spacing="16">
                                <icons:SymbolIcon FontSize="20" Symbol="Key" />
                                <Label
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    IsVisible="{Binding IsExpanded}"
                                    VerticalAlignment="Center">
                                    Passwords
                                </Label>
                            </StackPanel>
                        </Button>

                        <!--  Secure Notes  -->
                        <Button Classes.active="{Binding SecurityNotesActive}" Command="{Binding GoToSecurityCommand}">
                            <StackPanel
                                Margin="10,14"
                                Orientation="Horizontal"
                                Spacing="16">
                                <icons:SymbolIcon FontSize="20" Symbol="Note" />
                                <Label
                                    FontSize="16"
                                    IsVisible="{Binding IsExpanded}"
                                    VerticalAlignment="Center">
                                    Secure Notes
                                </Label>
                            </StackPanel>
                        </Button>

                        <!--  SECURITY TOOLS Header  -->
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#555555"
                            Margin="10,32,10,8"
                            Text="TOOLS" />

                        <!--  Personal Info  -->
                        <Button Classes.active="{Binding AccountPageActive}" Command="{Binding GoToAccountsCommand}">
                            <StackPanel
                                Margin="10,14"
                                Orientation="Horizontal"
                                Spacing="16">
                                <icons:SymbolIcon FontSize="20" Symbol="Person" />
                                <Label
                                    FontSize="16"
                                    IsVisible="{Binding IsExpanded}"
                                    VerticalAlignment="Center">
                                    Personal Info
                                </Label>
                            </StackPanel>
                        </Button>

                        <!--  Settings Center  -->
                        <Button Classes.active="{Binding SettingsPageActive}" Command="{Binding GoToSettingsCommand}">
                            <StackPanel
                                Margin="10,14"
                                Orientation="Horizontal"
                                Spacing="16">
                                <icons:SymbolIcon FontSize="20" Symbol="Settings" />
                                <Label
                                    FontSize="16"
                                    IsVisible="{Binding IsExpanded}"
                                    VerticalAlignment="Center">
                                    Settings
                                </Label>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!--  Bottom: Account  -->
                <StackPanel Grid.Row="3" Margin="24,16">
                    <Border
                        Background="#1E1E1E"
                        CornerRadius="8"
                        IsVisible="{Binding IsExpanded}"
                        Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="14"
                                Foreground="#AAAAAA"
                                Text="Created by: " />
                            <TextBlock
                                FontSize="15"
                                FontWeight="Medium"
                                Foreground="#CCCCCC"
                                Text="Tamjid Hossain Adol" />
                        </StackPanel>
                    </Border>

                    <!--  Version Check  -->
                    <Border
                        Background="#1E1E1E"
                        CornerRadius="8"
                        HorizontalAlignment="Stretch"
                        Margin="0,12,0,0"
                        Padding="16">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="15"
                                Foreground="#FF8C00"
                                Text="Version: " />
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="#FF8C00"
                                IsVisible="{Binding IsExpanded}"
                                Text="{Binding Version}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Background overlay  -->
        <Border
            Background="#80000000"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            IsVisible="{Binding BgPop}"
            ZIndex="1000" />

        <!--  Centered Login Card  -->
        <Grid
            Grid.Column="0"
            Grid.ColumnSpan="2"
            IsVisible="{Binding BgOp}"
            ZIndex="1001">

            <Border
                Background="{DynamicResource Primary_Background_Color}"
                BoxShadow="0 10 30 #40000000"
                CornerRadius="20"
                HorizontalAlignment="Center"
                Padding="30"
                VerticalAlignment="Center"
                Width="420">

                <StackPanel Spacing="18">

                    <!--  Title  -->
                    <TextBlock
                        FontSize="36"
                        FontWeight="Bold"
                        Foreground="White"
                        HorizontalAlignment="Center"
                        Text="Login" />

                    <TextBlock
                        FontSize="16"
                        Foreground="#cccccc"
                        HorizontalAlignment="Center"
                        Text="Vaultify your only trusted password companion" />

                    <Separator Margin="0,10" />

                    <!--  Password Label  -->
                    <TextBlock
                        FontSize="14"
                        Foreground="#dddddd"
                        Text="Password" />

                    <StackPanel Orientation="Horizontal">
                        <!--  Input  -->
                        <TextBox
                            BorderBrush="#444"
                            CornerRadius="8"
                            Height="40"
                            Padding="10"
                            PasswordChar="*"
                            RevealPassword="{Binding RevealPass}"
                            Text="{Binding Password}"
                            Watermark="Enter your password"
                            Width="330"
                            x:Name="LoginBox" />
                        <Button
                            Background="Transparent"
                            Command="{Binding RevealPasswordCommand}"
                            Height="40"
                            Width="50">
                            <icons:SymbolIcon Symbol="{Binding EyeIcon}" />
                        </Button>
                    </StackPanel>

                    <!--  Progress Bar  -->
                    <ProgressBar
                        CornerRadius="0"
                        Foreground="Orangered"
                        Height="27"
                        IsIndeterminate="True"
                        IsVisible="{Binding ProgressBarVisible}"
                        Margin="0,-8"
                        Maximum="100"
                        Minimum="0"
                        ShowProgressText="False" />
                    <!--  Status  -->
                    <TextBlock
                        FontSize="12"
                        Foreground="{Binding ColorsC}"
                        Text="{Binding StatusMessage}" />

                    <!--  Buttons  -->
                    <StackPanel Margin="0,10,0,0" Spacing="10">

                        <Button
                            BorderBrush="#666"
                            BorderThickness="1"
                            Classes="CardButton"
                            Command="{Binding LoginCommandCommand}"
                            Content="Sign In"
                            CornerRadius="10"
                            FontWeight="SemiBold"
                            Height="45"
                            IsDefault="True" />

                        <Separator />
                        <TextBlock Foreground="DarkGray" Text="If you forgot your password, you can register again" />

                        <Button
                            BorderBrush="#666"
                            BorderThickness="1"
                            Classes="CardButton"
                            Command="{Binding GotRegisterCommand}"
                            Content="Create Account"
                            CornerRadius="10"
                            Height="40" />

                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
        <!--  this is The Register Pop up window code  -->
        <Border
            Background="{DynamicResource Primary_Background_Color}"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            IsVisible="{Binding BgOpSignUp}"
            ZIndex="1000" />
        <!--  Interactive Popup for Add New (small "window" centered)  -->
        <Border
            Background="Black"
            CornerRadius="16"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            IsVisible="{Binding BgPopSignUp}"
            Padding="20"
            VerticalAlignment="Center"
            ZIndex="1001">
            <StackPanel HorizontalAlignment="Center" Spacing="10">
                <TextBlock
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="White"
                    Margin="200,0,220,0"
                    Text="Registration Form" />
                <TextBlock Foreground="#CCCCCC" Text="UserName" />
                <TextBox
                    KeyDown="TextBoxKeyDown"
                    Margin="0,0,60,0"
                    Text="{Binding UserName}"
                    Watermark="Crud55mustard7oil, techno blade etc."
                    Width="575" />
                <TextBlock Foreground="#CCCCCC" Text="Password" />
                <StackPanel Orientation="Horizontal">
                    <TextBox
                        KeyDown="TextBoxKeyDown"
                        PasswordChar="*"
                        RevealPassword="{Binding RevealPass}"
                        Text="{Binding Password}"
                        Watermark="Enter your password"
                        Width="575" />
                    <Button
                        Background="Transparent"
                        Command="{Binding RevealPasswordCommand}"
                        Height="40"
                        Width="50">
                        <icons:SymbolIcon Symbol="{Binding EyeIcon}" />
                    </Button>
                </StackPanel>
                <TextBlock Foreground="#CCCCCC" Text="Confirm Password" />
                <StackPanel Orientation="Horizontal">
                    <TextBox
                        KeyDown="TextBoxKeyDown"
                        PasswordChar="*"
                        RevealPassword="{Binding RevealPass}"
                        Text="{Binding ConfirmationPassword}"
                        Watermark="Confirm your password"
                        Width="575" />
                    <Button
                        Background="Transparent"
                        Command="{Binding RevealPasswordCommand}"
                        Height="40"
                        Width="50">
                        <icons:SymbolIcon Symbol="{Binding EyeIcon}" />
                    </Button>
                </StackPanel>

                <TextBlock Foreground="{Binding ColorsC}" Text="{Binding StatusMessage}" />
                <Button
                    Background="{DynamicResource Hover_Button_Background}"
                    Command="{Binding RegisterCommand}"
                    Content="Sign Up"
                    Foreground="AliceBlue"
                    HorizontalAlignment="Center" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="30">
                    <TextBlock FontSize="20" Foreground="White">Have an Account!!!</TextBlock>
                    <Button
                        Background="{DynamicResource Hover_Button_Background}"
                        Command="{Binding GotLoginCommand}"
                        Content="Got to Login page"
                        Foreground="AliceBlue" />
                </StackPanel>
            </StackPanel>
        </Border>


        <!--  Confirm Register Popup  -->
        <Border
            Background="#80000000"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            IsVisible="{Binding ConfimationDialog}"
            ZIndex="1200" />

        <Border
            Background="#1A1A1A"
            CornerRadius="16"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Height="240"
            HorizontalAlignment="Center"
            IsVisible="{Binding ConfimationDialog}"
            Padding="24"
            VerticalAlignment="Center"
            Width="460"
            ZIndex="1201">
            <StackPanel Spacing="16">
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Are you sure??" />
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="#FF8C00"
                    Text="Warning: Experimental feature" />
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="Red"
                    Text="You will lose all your data if you create a new account. We recommend exporting your data first. Are you sure you want to proceed?"
                    TextWrapping="Wrap" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        Background="Green"
                        BorderBrush="AliceBlue"
                        BorderThickness="1"
                        Command="{Binding YesButtonCommand}"
                        Content="Yes"
                        Foreground="Black" />
                    <Button
                        Background="Red"
                        BorderBrush="AliceBlue"
                        BorderThickness="1"
                        Command="{Binding CancelButtonCommand}"
                        Content="Cancel"
                        Foreground="Black" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>